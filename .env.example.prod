# Production environment for the co-hosted VPS deploy.
#
# On the VPS:  cp .env.example.prod .env.prod  &&  edit .env.prod
# `.env.prod` is git-ignored — never commit real values.

# production → Secure, HttpOnly cookies (the site MUST be served over HTTPS)
APP_ENV=production

# Exact public browser origin, no trailing slash. Used for the cookie and the
# WebSocket Origin check.
FRONTEND_ORIGIN=https://social.beyondedubh.com

LOG_LEVEL=info

# Every browser request reaches the backend from the frontend container, so the
# whole site shares ONE rate-limit bucket. Keep this well above the 1,200 default.
RATE_LIMIT_PER_MINUTE=6000

# Password reset delivery. Leave SMTP_HOST empty to disable it (the app logs a
# warning and the reset endpoints stay off). Anything else enables it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: host port for the loopback-only probe/debug listener (default 4100).
FRONTEND_PORT=4100
