  "info": {
    "_postman_id": "d9d360f6-6cf4-4da8-b68a-d618debd70a6",
    "name": "Real Time Forum API",
    "description": "This collection contains the main endpoints for a real-time forum application running locally. It covers core features such as user authentication, post and comment management, categories, reactions, messaging, and WebSocket-based real-time communication.\n\nThe requests are organized by feature area to make it easier to test the API workflow end to end, from registering and logging in users to creating posts, fetching comments, reacting to content, retrieving chat users and messages, and working with realtime connections. It also includes a simple echo endpoint for quick testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37789239"
  },
